<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <!-- Outer Glow Circle -->
    <path
        android:pathData="M48,6 A42,42 0 1,0 48,90 A42,42 0 1,0 48,6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12"
                android:startY="12"
                android:endX="84"
                android:endY="84">
                <item android:color="#FF4F46E5" android:offset="0.0" />
                <item android:color="#FF7C3AED" android:offset="0.5" />
                <item android:color="#FFEC4899" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Inner Shield / Rounded Square Shape -->
    <path
        android:pathData="M24,20 L72,20 A8,8 0 0,1 80,28 L80,68 A12,12 0 0,1 68,80 L28,80 A12,12 0 0,1 16,68 L16,28 A8,8 0 0,1 24,20 Z"
        android:fillColor="#151B2D" />
    <!-- Dynamic Achievement Checkmark Ribbon -->
    <path
        android:pathData="M28,48 L42,62 L70,32"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="32"
                android:endX="70"
                android:endY="62">
                <item android:color="#FF10B981" android:offset="0.0" />
                <item android:color="#FF38BDF8" android:offset="0.5" />
                <item android:color="#FFF59E0B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Sparkle Stars -->
    <path
        android:pathData="M68,22 L70,26 L74,28 L70,30 L68,34 L66,30 L62,28 L66,26 Z"
        android:fillColor="#FFFBBF24" />
</vector>
